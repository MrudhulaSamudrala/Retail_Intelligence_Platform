# BridgeAI local environment template
# Copy to .env and fill in values. Never commit real credentials.

# Application
APP_ENV=local
LOG_LEVEL=INFO

# Local PostgreSQL 18 (Windows native — not Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bridgeai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_password
# Optional full URL (overrides individual fields when set)
# DATABASE_URL=postgresql+psycopg://postgres:replace_with_your_password@localhost:5433/bridgeai

# SQLAlchemy
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Alembic uses the same DATABASE_URL / POSTGRES_* settings via database.connection

# Collection
COLLECTION_HEADLESS=true
COLLECTION_TIMEOUT_MS=45000
COLLECTION_RETRIES=3
SCREENSHOT_DIR=data/screenshots
USER_AGENT=
# If Newegg blocks automated Chromium, start a real Chrome with
# --remote-debugging-port=9222 and set:
# COLLECTION_CDP_URL=http://127.0.0.1:9222
COLLECTION_CDP_URL=
# Optional: COLLECTION_BROWSER_CHANNEL=chrome

# Official Mercado Libre API (optional read-only evidence layer).
# Leave empty to keep the existing web collector unchanged.
# Create an application at https://developers.mercadolibre.com (Brazil / MLB).
# Read scope is sufficient. Do not commit real credentials.
MERCADOLIBRE_API_ENABLED=
MERCADOLIBRE_API_CLIENT_ID=
MERCADOLIBRE_API_CLIENT_SECRET=
MERCADOLIBRE_API_ACCESS_TOKEN=
MERCADOLIBRE_API_REFRESH_TOKEN=
MERCADOLIBRE_API_SITE_ID=MLB
# MERCADOLIBRE_API_TIMEOUT_SECONDS=20

# Paths
CONFIG_DIR=config
REPORTS_DIR=reports
