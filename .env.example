# BridgeAI local environment template
# Copy to .env and fill in values. Never commit real credentials.

# Application
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (local or Render PostgreSQL connection string components)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bridgeai
POSTGRES_USER=bridgeai
POSTGRES_PASSWORD=change_me
# Optional full URL (overrides individual fields when set)
# DATABASE_URL=postgresql+psycopg://bridgeai:change_me@localhost:5432/bridgeai

# SQLAlchemy
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Alembic uses the same DATABASE_URL / POSTGRES_* settings via database.connection

# Collection (foundation defaults — scrapers not enabled in this phase)
COLLECTION_HEADLESS=true
COLLECTION_TIMEOUT_MS=30000
SCREENSHOT_DIR=data/screenshots
USER_AGENT=

# Paths
CONFIG_DIR=config
REPORTS_DIR=reports
